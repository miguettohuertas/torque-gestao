# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente local.
# NUNCA commite o arquivo ".env" de verdade (já está no .gitignore da raiz do repo).

# String de conexão do PostgreSQL.
# Ao rodar via docker-compose, o host é o nome do serviço ("db"), não "localhost".
DATABASE_URL=postgresql+psycopg2://torque:torque@db:5432/torque_gestao

# Segredo usado para assinar os tokens JWT (RF06). Gere um valor aleatório forte
# para produção — para desenvolvimento local, qualquer string longa serve.
JWT_SECRET_KEY=troque-este-valor-antes-de-ir-para-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Ambiente (development | test | production) — usado por app/config.py
ENVIRONMENT=development
